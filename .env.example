# =========================================================
# 全网内容收集与赛道收益工作台 - 环境配置示例
# 复制本文件为 .env 后按需填写（不填任何 Key 也可免费运行核心功能）
# =========================================================

# 1. 按次手动大模型翻译（兼容 OpenAI 格式：DeepSeek / Gemini / OpenAI / OpenRouter 等）
# 仅当你手动点击【翻译成中文】按钮时才会按次调用，绝不后台自动消耗 Token
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 2. 网页文章搜索（可选：Tavily 免费版每月 1000 次，无需绑卡）
# 留空时，网页文章页签自动提供一键跳转 Google / Google News / Medium / Substack
TAVILY_API_KEY=

# 3. YouTube Data API v3（可选：留空时默认使用免 Key 的 yt-dlp 通道）
YOUTUBE_API_KEY=

# 4. 本地语音识别镜像与设备（默认国内镜像；显卡缺 CUDA 库时会自动无感回退 CPU）
HF_ENDPOINT=https://hf-mirror.com
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
